---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { createClient } from '@libsql/client';
import { formatDate } from '@/lib/date';

interface CanteenEntry {
	message_id: string;
	content: string;
}

function snowflakeToTimestamp(snowflake: string): number {
	return Number((BigInt(snowflake) >> 22n) + 1420070400000n);
}

const turso = createClient({
	url: Astro.locals.runtime.env.TURSO_URI,
	authToken: Astro.locals.runtime.env.TURSO_TOKEN
});

const rows = (
	await turso.execute('SELECT * FROM canteen_log ORDER BY CAST(message_id AS INTEGER) DESC')
).rows as unknown as CanteenEntry[];
---

<BaseLayout title="Canteen Log">
	<h1 class="mb-2">Canteen Log</h1>
	<p class="mb-8">
		A running log of stuff I've gotten from my college canteen.
	</p>
	{
		rows.length === 0 ? (
			<p class="text-neutral-500">Nothing logged yet.</p>
		) : (
			<ul class="nolist flex flex-col">
				{rows.map((entry) => (
					<li class="py-8 first:pt-0 last:pb-0 border-b last:border-0 border-b-divider-stroke">
						<time class="block text-neutral-500 dark:text-neutral-400 mb-1">
							{formatDate(new Date(snowflakeToTimestamp(entry.message_id)), true)}
						</time>
						<p class="whitespace-pre-wrap">{entry.content}</p>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
